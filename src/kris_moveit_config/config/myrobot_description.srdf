    </group_state>
    <group_state name="default" group="head">
        <joint name="neck_yaw" value="0"/>
        <joint name="neck_pitch" value="0"/>
    </group_state>
    <end_effector name="left_finger_2" parent_link="left_finger_2" group="left_arm"/>
