<?xml version="1.0" encoding="UTF-8"?>
<robot name="myrobot_description">
    <group name="left_arm">
        <chain base_link="base_link" tip_link="left_wrist_2"/>
    </group>
    <group name="right_arm">
        <chain base_link="base_link" tip_link="right_wrist_2"/>
    </group>
    <group name="dual_arm">
        <group name="left_arm"/>
        <group name="right_arm"/>
    </group>
    <group name="head">
        <chain base_link="base_link" tip_link="camera"/>
    </group>
    <group name="left_hand">
        <link name="left_finger_1"/>
        <link name="left_finger_2"/>
    </group>
    <group name="right_hand">
        <link name="right_finger_1"/>
        <link name="right_finger_2"/>
    </group>
    <group_state name="default" group="dual_arm">
        <joint name="j11" value="0"/>
        <joint name="j12" value="0"/>
