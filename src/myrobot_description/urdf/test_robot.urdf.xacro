<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="myrobot_test">
  <!-- Include dynamixel hardware interface -->
  <xacro:include filename="$(find myrobot_moveit_config)/config/dynamixel_controllers.xml"/>
  
  <!-- Basic robot structure for testing -->
  <link name="base_link"/>
  
  <!-- Simple arm structure -->
  <link name="arm_1"/>
  <link name="arm_2"/>
  
  <joint name="j11" type="revolute">
    <parent link="base_link"/>
    <child link="arm_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="1.0"/>
  </joint>
  
  <joint name="j12" type="revolute">
    <parent link="arm_1"/>
    <child link="arm_2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="1.0"/>
  </joint>
  
  <!-- Use the dynamixel hardware macro -->
  <xacro:dynamixel_hardware/>
</robot>