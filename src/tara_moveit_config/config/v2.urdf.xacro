<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="v2">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import v2 urdf file -->
    <xacro:include filename="$(find myrobot_description)/urdf/v2.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="v2.ros2_control.xacro" />


    <xacro:v2_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
